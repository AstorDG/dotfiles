# Spacing around the equals sign does not matter.
# Any line beginning with a # is a comment.

# Display settings
theme = Kibble
font-size = 14
font-family = "MonoidNerdFont"
window-decoration = false
background-opacity = .7
background-blur = true

# System settings
confirm-close-surface = false
shell-integration = fish

#Shaders and colors
custom-shader = ~/.config/ghostty/shaders/cursor_warp.glsl
cursor-color  = #600C90
cursor-text   = #FFFFFF

# Keybind Section
keybind = ctrl+r=reload_config
keybind = alt+c=copy_url_to_clipboard
keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+a=select_all
keybind = ctrl+shift+c=open_config
keybind = ctrl+i=inspector:toggle
keybind = super+q=quit
keybind = ctrl+==increase_font_size:1.0
keybind = ctrl+-=decrease_font_size:1.0
keybind = ctrl+w=close_surface
