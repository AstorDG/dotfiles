// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
 "theme": "Cyberpunk Dark",
 "git_panel": {
  "sort_by": "path",
  "group_by": "status",
  "tree_view": true
 },
 "soft_wrap": "bounded",
 "preferred_line_length": 100,
 "search": {
  "include_ignored": true
 },
 "auto_install_extension": {
 	"charmed-icons": true,
  	"docker-compose": true,
   "dockerfile": true,
   "java": true,
   "markdown-oxide": true,
   "tokyo-night": true,
   "zig": true,
   "lua": true,
 },
 "disable_ai": false,
 "scroll_beyond_last_line": "off",
	"inlay_hints": {
		"enabled": true
	},
	"toolbar": {
		"quick_actions": false,
		"agent_review": false,
		"selections_menu": false,
		"breadcrumbs": false
	},
	"tab_size": 4,
	"show_whitespaces": "trailing",
	"hard_tabs": true,
	"tabs": {
		"file_icons": true,
		"git_status": false
	},
	"which_key": {
		"delay_ms": 100,
		"enabled": true
	},
	"ui_font_family": "Monoid Nerd Font",
	"buffer_font_family": "Monoid Nerd Font",
	"buffer_font_features": {
		"calt": true,
		"liga": true
	},
	"wsl_connections": [
  {
   "distro_name": "FedoraLinux-44",
   "user": null,
   "projects": [
    {
     "paths": [
      "/home/amgoujon"
     ]
    },
    {
     "paths": [
      "/home/amgoujon/Obsidian_Vaults"
     ]
    },
    {
     "paths": [
      "/home/amgoujon/Obsidian_Vaults/./"
     ]
    },
    {
     "paths": [
      "/home/amgoujon/code/docker-testing/./"
     ]
    },
    {
     "paths": [
      "/home/amgoujon/code/infrastructure"
     ]
    },
    {
     "paths": [
      "/home/amgoujon/code/infrastructure/./"
     ]
    },
    {
     "paths": [
      "/home/amgoujon/code/pokedex"
     ]
    },
    {
     "paths": [
      "/home/amgoujon/code/virtual_tcm"
     ]
    }
   ]
  }
 ],
	"telemetry": {
		"diagnostics": true,
		"metrics": false
	},
	"session": {
		"trust_all_worktrees": true
	},
	"vim_mode": true,
	"icon_theme": {
		"mode": "light",
		"light": "Zed (Default)",
		"dark": "Light Charmed Icons"
	},
	"ui_font_size": 16,
	"buffer_font_size": 15,
}
